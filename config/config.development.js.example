// Copy this file to config.development.js and adjust to your local setup.
// config.development.js is gitignored (it may contain secrets/local paths)
// and is NOT read automatically - Vite requires the real file to exist.

import common from "./config.common.js"

export default Object.assign({}, common, {
	configSource: "development",

	// The API ROOT of the backend. The client appends "/graphql", "/login/..." and "/webauthn/..."
	// itself, so do NOT end this in /graphql. Must be the host name shadow.fritz.box, not localhost:
	// WebAuthn origin check, and `npm run test:e2e` verifies it (tests/cypress-base-config.js).
	// This is environment DEV - see docs/liquido-testing.md.
	LIQUIDO_API_URL: "https://shadow.fritz.box:8443",

	// Set to true to run against the mocked GraphQL client, without a backend at all.
	// The header turns red as a visual warning while this is active.
	mockBackend: false,

	// DEV only: skip the real WebAuthn passkey ceremony (a headless browser has no
	// authenticator). See src/polly/polly-passkey.js. Only takes effect together with mockBackend.
	mockPasskey: false,

	showDebugLog: true,
})
